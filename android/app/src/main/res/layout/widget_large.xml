<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Grande (3×5): capa em destaque, texto e controlos completos. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/widget_margin">

    <LinearLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_surface"
        android:clipToOutline="true"
        android:padding="14dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/widget_artwork_frame"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher"
                android:contentDescription="@string/widget_cd_artwork" />
        </FrameLayout>

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/widget_default_title"
            android:textColor="@color/widget_on_surface"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/widget_default_artist"
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageButton
                    android:id="@+id/widget_repeat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_repeat_off"
                    android:background="@drawable/widget_icon_btn_bg"
                    android:contentDescription="@string/widget_cd_repeat"
                    android:scaleType="centerInside"
                    android:padding="9dp" />
            </FrameLayout>

            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageButton
                    android:id="@+id/widget_prev"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_prev"
                    android:tint="@color/widget_on_surface"
                    android:background="@drawable/widget_icon_btn_bg"
                    android:contentDescription="@string/widget_cd_prev"
                    android:scaleType="centerInside"
                    android:padding="9dp" />
            </FrameLayout>

            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageButton
                    android:id="@+id/widget_play_pause"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_play"
                    android:tint="@color/widget_on_accent"
                    android:background="@drawable/widget_play_bg"
                    android:contentDescription="@string/widget_cd_play_pause"
                    android:scaleType="centerInside"
                    android:padding="15dp" />
            </FrameLayout>

            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageButton
                    android:id="@+id/widget_next"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_widget_next"
                    android:tint="@color/widget_on_surface"
                    android:background="@drawable/widget_icon_btn_bg"
                    android:contentDescription="@string/widget_cd_next"
                    android:scaleType="centerInside"
                    android:padding="9dp" />
            </FrameLayout>

            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <ImageButton
                    android:id="@+id/widget_favorite"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_favorite_border"
                    android:background="@drawable/widget_icon_btn_bg"
                    android:contentDescription="@string/widget_cd_favorite"
                    android:scaleType="centerInside"
                    android:padding="9dp" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
