<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/widget_bg_dark"
        android:padding="16dp">

        <!-- Music note badge (top-right) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_artwork"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher"
                android:background="@drawable/widget_artwork_bg"
                android:contentDescription="Album art" />

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:src="@drawable/ic_widget_play"
                android:tint="#AAFFFFFF"
                android:contentDescription="Music note" />

        </FrameLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Constanza Músicas"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Artist -->
        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Artista"
            android:textColor="#99FFFFFF"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Controls: repeat / prev / play / next / star -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="14dp">

            <ImageButton
                android:id="@+id/widget_repeat"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@android:drawable/ic_menu_rotate"
                android:tint="#AAFFFFFF"
                android:background="@android:color/transparent"
                android:contentDescription="Repeat"
                android:scaleType="centerInside"
                android:padding="6dp" />

            <ImageButton
                android:id="@+id/widget_prev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_widget_prev"
                android:tint="#FFFFFF"
                android:background="@android:color/transparent"
                android:contentDescription="Previous"
                android:scaleType="centerInside"
                android:padding="6dp" />

            <ImageButton
                android:id="@+id/widget_play_pause"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_widget_play"
                android:tint="#FFFFFF"
                android:background="@drawable/widget_btn_bg"
                android:contentDescription="Play/Pause"
                android:scaleType="centerInside"
                android:padding="10dp" />

            <ImageButton
                android:id="@+id/widget_next"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_widget_next"
                android:tint="#FFFFFF"
                android:background="@android:color/transparent"
                android:contentDescription="Next"
                android:scaleType="centerInside"
                android:padding="6dp" />

            <ImageButton
                android:id="@+id/widget_favorite"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:src="@drawable/ic_favorite_border"
                android:tint="#AAFFFFFF"
                android:background="@android:color/transparent"
                android:contentDescription="Favorite"
                android:scaleType="centerInside"
                android:padding="6dp" />

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
