<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_bg_capsule"
        android:paddingStart="8dp"
        android:paddingEnd="12dp">

        <!-- Circular artwork (bitmap já vem rasterizado em círculo). -->
        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Album art" />

        <!-- Title -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="Constanza Músicas"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Play/Pause -->
        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_media_pause"
            android:tint="#FFFFFF"
            android:background="@android:color/transparent"
            android:contentDescription="Play/Pause"
            android:scaleType="centerInside"
            android:padding="6dp" />

        <!-- Next -->
        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_widget_next"
            android:tint="#CCFFFFFF"
            android:background="@android:color/transparent"
            android:contentDescription="Next"
            android:scaleType="centerInside"
            android:padding="6dp" />

    </LinearLayout>
</FrameLayout>
