<?xml version="1.0" encoding="utf-8"?>
<!-- Widget Cápsula (4×1): capa circular, título/artista, play e seguinte. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/widget_margin">

    <LinearLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_bg_capsule"
        android:clipToOutline="true"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- O bitmap já vem recortado em círculo. -->
        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="fitCenter"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/widget_cd_artwork" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_default_title"
                android:textColor="@color/widget_on_surface"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/widget_default_artist"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_widget_play"
            android:tint="@color/widget_on_accent"
            android:background="@drawable/widget_play_bg"
            android:contentDescription="@string/widget_cd_play_pause"
            android:scaleType="centerInside"
            android:padding="11dp" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_widget_next"
            android:tint="@color/widget_on_surface"
            android:background="@drawable/widget_icon_btn_bg"
            android:contentDescription="@string/widget_cd_next"
            android:scaleType="centerInside"
            android:padding="9dp" />
    </LinearLayout>
</FrameLayout>
