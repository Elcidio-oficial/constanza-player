<?xml version="1.0" encoding="utf-8"?>
<!--
    Data Extraction Rules (Android 12+).
    Cobre tanto cloud backup quanto transferências device-to-device.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="cache" path="."/>
        <exclude domain="file" path="crashes.jsonl"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="cache" path="."/>
    </device-transfer>
</data-extraction-rules>
