<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup (Android 6.0+, legacy schema).
    Apenas SharedPreferences entram no backup. Outros domínios (cache, file)
    ficam fora por default — exclude só funciona dentro de domain incluído.
-->
<full-backup-content>
    <include domain="sharedpref" path="."/>
</full-backup-content>
