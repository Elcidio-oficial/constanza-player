<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissões para ler áudio -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Permissão para escrever/modificar arquivos de áudio (Android ≤ 10) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Internet para fotos de artistas online -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Foreground service / background playback / lock screen -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Controles de mídia na tela de bloqueio (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Isenção de Battery Optimization (Doze mode) — usuário decide -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Leitor flutuante: sobrepor a outras apps (ao tocar áudio pelo
         explorador, o mini leitor aparece por cima do gerenciador de
         arquivos). Concedida pelo usuário em Configurações. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:label="Constanza Músicas"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <!-- Desativa o deep linking automático do Flutter. Sem isto, a URI
                 do intent ACTION_VIEW (abrir áudio do gerenciador de arquivos)
                 é entregue ao go_router como rota — ex.: "/external_files/..." —
                 e cai em "Page Not Found". O áudio externo já é tratado pelo
                 canal nativo (INTENT_CHANNEL → DefaultPlayerService), não por
                 rotas; a navegação de widgets também usa MethodChannel. -->
            <meta-data
                android:name="flutter_deeplinking_enabled"
                android:value="false" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Alias da MainActivity para o arranque a frio por áudio: mesma
             activity/engine, mas com tema TRANSLÚCIDO (AudioColdStartTheme) → o
             explorador fica à vista enquanto a app arranca o motor e vai para
             trás, sem flash. Sem meta-data NormalTheme (de propósito): assim o
             FlutterFragmentActivity NÃO troca o tema translúcido por um opaco no
             onCreate. Não exportado: só o trampolim o lança, por componente
             explícito (e com o EXTRA_RESOLVED que ativa o modo transparente). -->
        <activity-alias
            android:name=".MainActivityAudioOpen"
            android:targetActivity=".MainActivity"
            android:exported="false"
            android:theme="@style/AudioColdStartTheme" />

        <!-- ===== Trampolim do leitor flutuante / leitor padrão de áudio =====
             Activity nativa PURA (NÃO-Flutter), translúcida e invisível, alvo dos
             intents de áudio (Abrir com / Compartilhar). NÃO pode ser FlutterActivity:
             agarraria o FlutterEngine partilhado e despejaria a MainActivity →
             "engine evicted" → UI congelada (bug confirmado em logcat). Em vez disso
             empurra a música pelo motor existente (a quente) ou reencaminha para a
             MainActivity (a frio). excludeFromRecents: não aparece nos recentes só
             por se abrir um ficheiro. taskAffinity próprio: task separada da
             MainActivity (o ícone/launcher continua a abrir a UI real). -->
        <activity
            android:name=".AudioOpenActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.constanza.constanza_player.audioopen"
            android:excludeFromRecents="true"
            android:theme="@style/TranslucentTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true">

            <!-- Abrir com: Faz o Constanza aparecer no "Abrir com" de qualquer
                 arquivo de áudio. Ao escolher "Sempre", vira leitor padrão. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
                <data android:mimeType="application/x-ogg" />
                <data android:mimeType="application/itunes" />
                <data android:scheme="content" />
                <data android:scheme="file" />
            </intent-filter>

            <!-- Receber áudio compartilhado: Compartilhar → Constanza -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Serviço de mídia em background para notificação e tela de bloqueio -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Receiver para botões de mídia (headsets, lock screen) -->
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <!-- Home Screen Widgets -->
        <receiver android:name=".MusicWidgetProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.constanza.constanza_player.WIDGET_PREV" />
                <action android:name="com.constanza.constanza_player.WIDGET_PLAY_PAUSE" />
                <action android:name="com.constanza.constanza_player.WIDGET_NEXT" />
                <action android:name="com.constanza.constanza_player.WIDGET_TOGGLE_FAV" />
                <action android:name="com.constanza.constanza_player.WIDGET_TOGGLE_REPEAT" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/music_widget_info" />
        </receiver>

        <receiver android:name=".WidgetLargeProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.constanza.constanza_player.WIDGET_PREV" />
                <action android:name="com.constanza.constanza_player.WIDGET_PLAY_PAUSE" />
                <action android:name="com.constanza.constanza_player.WIDGET_NEXT" />
                <action android:name="com.constanza.constanza_player.WIDGET_TOGGLE_FAV" />
                <action android:name="com.constanza.constanza_player.WIDGET_TOGGLE_REPEAT" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_large_info" />
        </receiver>

        <receiver android:name=".WidgetMediumSearchProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.constanza.constanza_player.WIDGET_PREV" />
                <action android:name="com.constanza.constanza_player.WIDGET_PLAY_PAUSE" />
                <action android:name="com.constanza.constanza_player.WIDGET_NEXT" />
                <action android:name="com.constanza.constanza_player.WIDGET_OPEN_SEARCH" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_medium_search_info" />
        </receiver>

        <receiver android:name=".WidgetCapsuleProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.constanza.constanza_player.WIDGET_PLAY_PAUSE" />
                <action android:name="com.constanza.constanza_player.WIDGET_NEXT" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_capsule_info" />
        </receiver>

        <receiver android:name=".WidgetRecommendationProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.constanza.constanza_player.WIDGET_PLAY_PAUSE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_recommendation_info" />
        </receiver>

        <receiver android:name=".WidgetRecommendedProvider" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.constanza.constanza_player.WIDGET_PREV" />
                <action android:name="com.constanza.constanza_player.WIDGET_PLAY_PAUSE" />
                <action android:name="com.constanza.constanza_player.WIDGET_NEXT" />
                <action android:name="com.constanza.constanza_player.WIDGET_TOGGLE_FAV" />
                <action android:name="com.constanza.constanza_player.WIDGET_OPEN_NOW_PLAYING" />
                <action android:name="com.constanza.constanza_player.WIDGET_OPEN_QUEUE" />
                <action android:name="com.constanza.constanza_player.WIDGET_OPEN_PLAYLISTS" />
                <action android:name="com.constanza.constanza_player.WIDGET_OPEN_SETTINGS" />
                <action android:name="com.constanza.constanza_player.WIDGET_OPEN_SLEEP_TIMER" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_recommended_info" />
        </receiver>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
